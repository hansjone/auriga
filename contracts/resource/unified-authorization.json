{
  "schemaVersion": 1,
  "default": "deny",
  "rules": [
    {
      "kind": "plugin",
      "delivery": "npm-tgz",
      "entry": "unified",
      "basePermission": "resource.packages.upload",
      "minimumRisk": "r2",
      "level": "l3",
      "p1Enabled": true
    },
    {
      "kind": "skill",
      "delivery": "text-only",
      "entry": "unified",
      "basePermission": "resource.packages.upload",
      "minimumRisk": "r1",
      "commandMinimumRisk": "r2",
      "level": "l3",
      "p1Enabled": true
    },
    {
      "kind": "tool",
      "delivery": "online",
      "entry": "unified",
      "basePermission": "resource.packages.upload",
      "minimumRisk": "r2",
      "p1Enabled": false,
      "requiredGates": [
        "delivery-permission",
        "endpoint-credential-authorization",
        "network-authorization"
      ]
    },
    {
      "kind": "tool",
      "delivery": "offline",
      "entry": "unified",
      "basePermission": "resource.packages.upload",
      "minimumRisk": "r2",
      "p1Enabled": false,
      "requiredGates": [
        "delivery-permission",
        "platform-authorization",
        "provenance"
      ]
    },
    {
      "kind": "tool",
      "delivery": "git",
      "entry": "unified",
      "basePermission": "resource.packages.upload",
      "minimumRisk": "r3",
      "p1Enabled": false,
      "requiredGates": [
        "delivery-permission",
        "commit-provenance",
        "isolated-build-authorization"
      ]
    }
  ],
  "desktopSelfSubmission": {
    "principal": "device",
    "audience": "auriga",
    "authorizationModes": ["standard_device", "native_tx"],
    "membership": "active-internal-member",
    "requiresLiveBoundPortalSession": true,
    "kinds": ["plugin", "skill"],
    "ownedPackageRequired": true,
    "operations": [
      "UnifiedCreateResourcePackage",
      "UnifiedGetResourcePackage",
      "UnifiedUploadResourceVersion",
      "UnifiedSubmitResourceVersion"
    ]
  },
  "securityReviewRoleRequiresQualification": true,
  "rawDownloadRequires": [
    "authenticated-tenant",
    "package-version-visibility",
    "resource.packages.read"
  ],
  "distributionPermission": "resource.distributions.manage",
  "securityReviewQualification": {
    "permission": "resource.versions.security_review",
    "source": "ResourceAccessInputs.permissions",
    "trustedInput": "server-resolved-current-tenant-permissions",
    "clientRoleIsDeclarationOnly": true,
    "independentlyGrantable": true,
    "revocable": true,
    "checkAt": ["review-decision", "publication"],
    "requireSameTenant": true,
    "authorMayReview": false,
    "countDistinctBy": "tenantId+reviewerId",
    "revokedSecurityReviewCounts": false,
    "missingQualificationError": "common.forbidden",
    "insufficientPublicationQuorumError": "resource.review_required",
    "fixtures": "security-review-fixtures.json",
    "revocationScope": {
      "builtinOwner": "remove-owner-role",
      "customRole": "revoke-permission-or-role"
    }
  }
}
