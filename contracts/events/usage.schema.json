{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "usage.*事件：唯一生产方见catalog/m3.json",
  "$defs": {
    "UsageRecorded": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "format": "uuid"
        },
        "accountId": {
          "type": "string",
          "format": "uuid"
        },
        "instanceId": {
          "type": "string",
          "format": "uuid"
        },
        "deviceId": {
          "type": "string",
          "format": "uuid"
        },
        "modelId": {
          "type": "string"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "completed",
            "failed",
            "cancelled",
            "unknown"
          ]
        },
        "inputTokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "outputTokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "costMicros": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "usageQuality": {
          "type": "string",
          "enum": [
            "confirmed",
            "estimated",
            "unknown"
          ]
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "dayPeriodStart": {
          "type": "string",
          "format": "date-time"
        },
        "monthPeriodStart": {
          "type": "string",
          "format": "date-time"
        },
        "priceVersion": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "format": "int64",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "requestId",
        "accountId",
        "modelId",
        "outcome",
        "inputTokens",
        "outputTokens",
        "costMicros",
        "usageQuality",
        "currency",
        "dayPeriodStart",
        "monthPeriodStart",
        "priceVersion",
        "revision"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "usageQuality": {
                "const": "unknown"
              }
            },
            "required": [
              "usageQuality"
            ]
          },
          "then": {
            "properties": {
              "inputTokens": {
                "type": "null"
              },
              "outputTokens": {
                "type": "null"
              },
              "costMicros": {
                "type": "null"
              }
            }
          }
        },
        {
          "oneOf": [
            {
              "properties": {
                "instanceId": {
                  "type": "string",
                  "format": "uuid"
                },
                "deviceId": false
              },
              "required": [
                "instanceId"
              ]
            },
            {
              "properties": {
                "deviceId": {
                  "type": "string",
                  "format": "uuid"
                },
                "instanceId": false
              },
              "required": [
                "deviceId"
              ]
            }
          ]
        }
      ]
    }
  }
}
