{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AdminSecNet egress file channel v1",
  "$defs": {
    "Value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["categories", "allowDomains", "denyDomains"],
      "properties": {
        "categories": {
          "type": "array",
          "maxItems": 0,
          "items": { "type": "string" }
        },
        "allowDomains": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "type": "string", "maxLength": 255 }
        },
        "denyDomains": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "type": "string", "maxLength": 255 }
        }
      }
    },
    "Snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "tenantId", "version", "value"],
      "properties": {
        "schemaVersion": { "type": "integer", "const": 1 },
        "tenantId": { "type": "string", "format": "uuid" },
        "version": { "type": "integer", "minimum": 1 },
        "value": { "$ref": "#/$defs/Value" }
      }
    },
    "Report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenantId",
        "version",
        "nodeId",
        "digest",
        "result",
        "appliedVersion",
        "reportedAt"
      ],
      "properties": {
        "tenantId": { "type": "string", "format": "uuid" },
        "version": { "type": "integer", "minimum": 1 },
        "nodeId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "result": { "type": "string", "enum": ["applied", "failed"] },
        "appliedVersion": { "type": "integer", "minimum": 0 },
        "reportedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "$ref": "#/$defs/Snapshot"
}
