{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "受信部署入口 v1（IP0；运行时接线待 IP1–IP3）",
  "description": "安装者提供的输入，不从 Host、Forwarded、实例 profile 或心跳派生。结构校验之后仍须执行 README.md 的启动语义验证；本 schema 不表示现有程序已加载这些字段。",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "mode": {
      "enum": ["domain", "ip"]
    },
    "tenantId": {
      "type": "string",
      "format": "uuid"
    },
    "portalOrigin": {
      "$ref": "#/$defs/Origin"
    },
    "adminOrigin": {
      "$ref": "#/$defs/Origin"
    },
    "issuerOrigin": {
      "$ref": "#/$defs/Origin"
    },
    "insecureHttpAcknowledged": {
      "type": "boolean"
    },
    "listeners": {
      "type": "object",
      "properties": {
        "portal": {
          "$ref": "#/$defs/Listener"
        },
        "admin": {
          "$ref": "#/$defs/Listener"
        },
        "instanceControl": {
          "$ref": "#/$defs/Listener"
        }
      },
      "required": ["portal", "admin", "instanceControl"],
      "additionalProperties": false
    },
    "ingress": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "direct"
            }
          },
          "required": ["kind"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "trusted_proxy"
            },
            "peerCidrs": {
              "description": "启动时须逐项解析为规范 CIDR，拒绝 /0；实际 TCP 对端与 mTLS 身份须同时匹配。",
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 3,
                "maxLength": 49
              },
              "minItems": 1,
              "maxItems": 16,
              "uniqueItems": true
            },
            "requireMtls": {
              "const": true
            },
            "preserveAuthority": {
              "const": true
            }
          },
          "required": ["kind", "peerCidrs", "requireMtls", "preserveAuthority"],
          "additionalProperties": false
        }
      ]
    },
    "instances": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "path"
            },
            "prefix": {
              "const": "/i/"
            },
            "trustedTeamAcknowledged": {
              "const": true
            }
          },
          "required": ["mode", "prefix", "trustedTeamAcknowledged"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "subdomain"
            },
            "parentDomain": {
              "$ref": "#/$defs/DnsName"
            },
            "scheme": {
              "enum": ["http", "https"]
            },
            "port": {
              "$ref": "#/$defs/Port"
            }
          },
          "required": ["mode", "parentDomain", "scheme", "port"],
          "additionalProperties": false
        }
      ]
    },
    "instanceControl": {
      "type": "object",
      "properties": {
        "dnsAlias": {
          "$ref": "#/$defs/DnsName"
        },
        "origin": {
          "allOf": [
            {
              "$ref": "#/$defs/Origin"
            },
            {
              "properties": {
                "host": {
                  "$ref": "#/$defs/DnsName"
                }
              },
              "type": "object"
            }
          ]
        },
        "edgeContainer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
        }
      },
      "required": ["dnsAlias", "origin", "edgeContainer"],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "mode",
    "tenantId",
    "portalOrigin",
    "adminOrigin",
    "issuerOrigin",
    "insecureHttpAcknowledged",
    "listeners",
    "ingress",
    "instances",
    "instanceControl"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "ip"
          }
        },
        "type": "object"
      },
      "then": {
        "properties": {
          "portalOrigin": {
            "properties": {
              "host": {
                "format": "ipv4",
                "type": "string"
              }
            },
            "type": "object"
          },
          "adminOrigin": {
            "properties": {
              "host": {
                "format": "ipv4",
                "type": "string"
              }
            },
            "type": "object"
          },
          "issuerOrigin": {
            "properties": {
              "host": {
                "format": "ipv4",
                "type": "string"
              }
            },
            "type": "object"
          },
          "instances": {
            "properties": {
              "mode": {
                "const": "path"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "else": {
        "properties": {
          "portalOrigin": {
            "properties": {
              "host": {
                "$ref": "#/$defs/DnsName"
              }
            },
            "type": "object"
          },
          "adminOrigin": {
            "properties": {
              "host": {
                "$ref": "#/$defs/DnsName"
              }
            },
            "type": "object"
          },
          "issuerOrigin": {
            "properties": {
              "host": {
                "$ref": "#/$defs/DnsName"
              }
            },
            "type": "object"
          },
          "instances": {
            "properties": {
              "mode": {
                "const": "subdomain"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    }
  ],
  "$defs": {
    "Port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "DnsName": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?$",
      "not": {
        "format": "ipv4",
        "type": "string"
      }
    },
    "Origin": {
      "description": "结构化 Origin：不接受 URL、userinfo、路径、查询、片段、通配符。生成浏览器字符串时默认端口省略；host 必须已规范化。",
      "type": "object",
      "properties": {
        "scheme": {
          "enum": ["http", "https"]
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[a-z0-9.-]+$"
        },
        "port": {
          "$ref": "#/$defs/Port"
        }
      },
      "required": ["scheme", "host", "port"],
      "additionalProperties": false
    },
    "Listener": {
      "type": "object",
      "properties": {
        "address": {
          "type": "string",
          "format": "ipv4"
        },
        "port": {
          "$ref": "#/$defs/Port"
        },
        "tls": {
          "type": "boolean"
        }
      },
      "required": ["address", "port", "tls"],
      "additionalProperties": false
    }
  }
}
