{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ShellAuth 本机控制及企业 skill 兼容端口",
  "$defs": {
    "ShellAuthLoopbackExchange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ticket": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "clientNonce": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      },
      "required": [
        "ticket",
        "clientNonce"
      ]
    },
    "ShellAuthPageSession": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pageToken": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "csrf": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "shellEpoch": {
          "type": "string",
          "format": "uuid"
        },
        "origin": {
          "type": "string",
          "pattern": "^http://127\\.0\\.0\\.1:[0-9]{1,5}$"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "clientNonce": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "pageOwner": {
          "type": "string",
          "format": "uuid",
          "description": "broker为票据交换生成的页面归属ID，设备尝试只回送同一owner；不作为令牌且不接受命令自报。"
        }
      },
      "required": [
        "pageToken",
        "csrf",
        "shellEpoch",
        "origin",
        "port",
        "clientNonce",
        "expiresAt"
      ]
    },
    "ShellAuthEnterpriseConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowRawAgentToken": {
          "type": "boolean",
          "default": true
        },
        "outboundAllowedHosts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
          },
          "default": [],
          "description": "缺省或空数组均拒绝全部；真实主机仅私有部署配置提供。"
        },
        "taskCapabilityTtlSeconds": {
          "type": "integer",
          "const": 600,
          "default": 600
        }
      },
      "required": []
    },
    "ShellAuthAgentCredentialsRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "dshSessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "taskCapability": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "capability": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        }
      },
      "required": []
    },
    "ShellAuthAgentCredentials": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "empNo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "updatedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "required": [
        "empNo",
        "token",
        "updatedAt"
      ]
    },
    "ShellAuthOutboundRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 2048
        },
        "method": {
          "type": "string",
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE",
            "HEAD"
          ],
          "default": "POST"
        },
        "headers": {
          "type": "object",
          "description": "兼容原型输入；仅content-type/accept/accept-language/x-lang-id/x-requested-with不分大小写保留，非空值String转换并截为1024字符，其余静默丢弃。",
          "additionalProperties": true
        },
        "body": {},
        "timeoutMs": {
          "description": "原型兼容：有效超时=min(Number(value)||30000,60000)，超过60000截断而不是拒绝。"
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "dshSessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "taskCapability": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "capability": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        }
      },
      "required": [
        "url"
      ]
    },
    "ShellAuthOutboundResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "statusCode": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "body": {
          "type": "string",
          "maxLength": 2097152
        },
        "json": {}
      },
      "required": [
        "statusCode",
        "headers",
        "body",
        "json"
      ]
    },
    "ShellAuthAgentError": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "hint": {
          "type": "string",
          "maxLength": 512
        },
        "sessionId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        }
      },
      "required": [
        "error",
        "message"
      ]
    },
    "ShellAuthOutboundForwardedHeaders": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(?:[cC][oO][nN][tT][eE][nN][tT]-[tT][yY][pP][eE]|[aA][cC][cC][eE][pP][tT]|[aA][cC][cC][eE][pP][tT]-[lL][aA][nN][gG][uU][aA][gG][eE]|[xX]-[lL][aA][nN][gG]-[iI][dD]|[xX]-[rR][eE][qQ][uU][eE][sS][tT][eE][dD]-[wW][iI][tT][hH])$"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 1024
      }
    },
    "ShellAuthPageCommand": {
      "type": "object",
      "required": [
        "protocolVersion",
        "requestId",
        "shellEpoch",
        "expectedRevision",
        "action"
      ],
      "properties": {
        "protocolVersion": {
          "type": "integer",
          "enum": [
            1
          ]
        },
        "requestId": {
          "type": "string",
          "format": "uuid"
        },
        "shellEpoch": {
          "type": "string",
          "format": "uuid"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        },
        "action": {
          "type": "string",
          "enum": [
            "snapshot",
            "open_login",
            "cancel_login",
            "skip_login"
          ]
        }
      },
      "additionalProperties": false,
      "description": "端口绑定控制页命令子集。skip_login只在未认证/认证中取消尝试并返回本地DSH，不调用logout，不撤销已有有效身份；已认证时拒绝冲突。"
    }
  }
}
