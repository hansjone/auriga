{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ShellAuth IPC 草案",
  "$defs": {
    "ShellAuthSnapshot": {
      "type": "object",
      "required": [
        "protocolVersion",
        "shellEpoch",
        "revision",
        "state",
        "expiresAt"
      ],
      "properties": {
        "protocolVersion": {
          "type": "integer",
          "enum": [
            1
          ]
        },
        "shellEpoch": {
          "type": "string",
          "format": "uuid"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "state": {
          "type": "string",
          "enum": [
            "signed_out",
            "authenticating",
            "authenticated",
            "unreachable",
            "reauth_required",
            "revoked"
          ]
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "identity": {
          "$ref": "#/$defs/ShellAuthIdentity"
        },
        "reason": {
          "type": "string",
          "enum": [
            "user_action",
            "expired",
            "offline",
            "source_disabled",
            "account_changed",
            "shell_restarted",
            "revalidation_rejected",
            "revalidation_unreachable",
            "user_logout",
            "admin_disabled",
            "member_disabled",
            "platform_rejected",
            "login_denied",
            "rate_limited"
          ]
        },
        "uacLoginInfo": {
          "$ref": "../auth/uac-login-info.schema.json#/$defs/UacLoginInfo",
          "description": "仅authenticated且身份匹配时的可选只读展示资料，注销或切换身份立即清除"
        },
        "deviceAttempt": {
          "$ref": "#/$defs/ShellAuthDeviceAttempt"
        },
        "loginError": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "correlationId"
          ],
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,127}$"
            },
            "correlationId": {
              "type": "string",
              "format": "uuid"
            }
          },
          "description": "Bounded platform login error code and correlation UUID. No response body or credentials. Cleared on new login, cancellation or logout."
        },
        "inlineLogin": {
          "$ref": "#/$defs/ShellAuthInlineView"
        },
        "localUacProof": {
          "type": "boolean",
          "description": "Automatic local identity association is in progress; no browser-device authorization UI is needed."
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "authenticated"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "identity"
            ],
            "properties": {
              "identity": {}
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "signed_out",
                  "authenticating",
                  "revoked"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "not": {
              "required": [
                "identity"
              ],
              "properties": {
                "identity": {}
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "signed_out",
                  "authenticating",
                  "unreachable",
                  "reauth_required",
                  "revoked"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "not": {
              "required": [
                "uacLoginInfo"
              ],
              "properties": {
                "uacLoginInfo": {}
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "deviceAttempt"
            ],
            "properties": {
              "deviceAttempt": {}
            }
          },
          "then": {
            "properties": {
              "state": {
                "const": "authenticating"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "inlineLogin"
            ],
            "properties": {
              "inlineLogin": {}
            }
          },
          "then": {
            "properties": {
              "state": {
                "const": "authenticating"
              }
            }
          }
        }
      ]
    },
    "ShellAuthIdentity": {
      "type": "object",
      "required": [
        "tenantId",
        "memberId",
        "deviceId",
        "providerId"
      ],
      "properties": {
        "tenantId": {
          "type": "string",
          "format": "uuid"
        },
        "memberId": {
          "type": "string",
          "format": "uuid"
        },
        "deviceId": {
          "type": "string",
          "format": "uuid"
        },
        "providerId": {
          "type": "string",
          "format": "uuid"
        },
        "empNo": {
          "type": "string",
          "maxLength": 128
        },
        "uacSessionBinding": {
          "$ref": "../auth/uac-session-binding.schema.json#/$defs/UacSessionBinding"
        }
      },
      "additionalProperties": false
    },
    "ShellAuthCommand": {
      "type": "object",
      "required": [
        "protocolVersion",
        "requestId",
        "shellEpoch",
        "expectedRevision",
        "action"
      ],
      "properties": {
        "protocolVersion": {
          "type": "integer",
          "enum": [
            1
          ]
        },
        "requestId": {
          "type": "string",
          "format": "uuid"
        },
        "shellEpoch": {
          "type": "string",
          "format": "uuid"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        },
        "action": {
          "type": "string",
          "enum": [
            "snapshot",
            "subscribe",
            "open_login",
            "cancel_login",
            "logout",
            "inline_login",
            "inline_advance"
          ]
        },
        "input": {
          "$ref": "#/$defs/ShellAuthInlineInput"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "inline_advance"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "input"
            ],
            "properties": {
              "input": {}
            }
          },
          "else": {
            "not": {
              "required": [
                "input"
              ],
              "properties": {
                "input": {}
              }
            }
          }
        }
      ]
    },
    "ShellAuthEvent": {
      "type": "object",
      "required": [
        "protocolVersion",
        "requestId",
        "type"
      ],
      "properties": {
        "protocolVersion": {
          "type": "integer",
          "enum": [
            1
          ]
        },
        "requestId": {
          "type": "string",
          "format": "uuid"
        },
        "type": {
          "type": "string",
          "enum": [
            "snapshot",
            "changed",
            "ack",
            "error"
          ]
        },
        "snapshot": {
          "$ref": "#/$defs/ShellAuthSnapshot"
        },
        "code": {
          "type": "string",
          "enum": [
            "common.conflict",
            "common.unauthenticated",
            "common.forbidden",
            "common.unavailable",
            "common.validation_failed"
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "error"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "code"
            ],
            "properties": {
              "code": {}
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "snapshot",
                  "changed"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "snapshot"
            ],
            "properties": {
              "snapshot": {}
            }
          }
        }
      ]
    },
    "ShellAuthDeviceAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attemptId",
        "pageOwner",
        "userCode",
        "expiresAt",
        "verificationRequired"
      ],
      "properties": {
        "attemptId": {
          "type": "string",
          "format": "uuid"
        },
        "pageOwner": {
          "type": "string",
          "format": "uuid"
        },
        "userCode": {
          "type": "string",
          "pattern": "^[BCDFGHJKLMNPQRSTVWXZ]{4}-?[BCDFGHJKLMNPQRSTVWXZ]{4}$"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "verificationRequired": {
          "type": "boolean",
          "not": {
            "const": false
          }
        }
      },
      "description": "broker只向发起控制页投影本次公开用户码；pageOwner来自票据交换的服务端页面会话，不接受命令自报。必须提示用户在可信门户人工核对本次用户码。无device_code、令牌或URL。"
    },
    "ShellAuthInlineInput": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation"
          ],
          "properties": {
            "operation": {
              "const": "poll"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "providerId"
          ],
          "properties": {
            "operation": {
              "const": "select"
            },
            "providerId": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "formId",
            "values"
          ],
          "properties": {
            "operation": {
              "const": "submit"
            },
            "formId": {
              "type": "string",
              "maxLength": 128
            },
            "values": {
              "type": "object",
              "maxProperties": 32,
              "propertyNames": {
                "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
              },
              "additionalProperties": {
                "oneOf": [
                  {
                    "type": "string",
                    "maxLength": 4096
                  },
                  {
                    "type": "boolean"
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "ShellAuthInlineView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providers",
        "providerId",
        "step"
      ],
      "properties": {
        "providers": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "connectorType",
              "displayName"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "connectorType": {
                "enum": [
                  "uac",
                  "team-account",
                  "emergency"
                ]
              },
              "displayName": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "maxLength": 256
                }
              }
            }
          }
        },
        "providerId": {
          "type": "string",
          "format": "uuid"
        },
        "step": {
          "oneOf": [
            {
              "$ref": "../identity/steps.schema.json#/$defs/FormStep"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "content",
                "status",
                "expiresAt"
              ],
              "properties": {
                "type": {
                  "const": "qr"
                },
                "content": {
                  "type": "string",
                  "maxLength": 2048
                },
                "status": {
                  "enum": [
                    "waiting",
                    "scanned"
                  ]
                },
                "expiresAt": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          ]
        }
      }
    },
    "ShellAuthLocalUacCredential": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation",
        "empNo",
        "token"
      ],
      "properties": {
        "generation": {
          "type": "string",
          "format": "uuid"
        },
        "empNo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384,
          "writeOnly": true
        }
      },
      "description": "OS-authenticated plugin backend only. Memory-only local generation fences attempts, never asserted as IAM identity."
    },
    "ShellAuthLocalUacCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "requestId",
        "shellEpoch",
        "sequence",
        "expiresAt",
        "credential"
      ],
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "requestId": {
          "type": "string",
          "format": "uuid"
        },
        "shellEpoch": {
          "type": "string",
          "format": "uuid"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "credential": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/ShellAuthLocalUacCredential"
            }
          ]
        }
      }
    }
  }
}
