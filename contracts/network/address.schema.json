{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auriga.example.com/contracts/network/address.schema.json",
  "title": "Auriga 网络地址 v1",
  "description": "aur1 结构化地址与按字段角色区分的子集；文本语法、规范化与拒绝顺序见 README.md §2。uint64 一律十进制字符串，不经 JSON number。",
  "$defs": {
    "Uint64": {
      "description": "无前导零十进制 uint64 字符串，0..18446744073709551615。",
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)$"
    },
    "PositiveUint64": {
      "description": "≥1 的 uint64 十进制字符串。",
      "type": "string",
      "allOf": [
        {
          "$ref": "#/$defs/Uint64"
        },
        {
          "not": {
            "const": "0"
          }
        }
      ]
    },
    "AddressType": {
      "type": "string",
      "enum": [
        "system",
        "session",
        "subagent",
        "group"
      ]
    },
    "AddressText": {
      "description": "aur1:[realm.]node.local，各段无前导零小写十六进制、1..16 位；段值约束（realm≥1、node=0 仅 group 等）由解析器按 README §2 判定。",
      "type": "string",
      "pattern": "^aur1:(?:0|[1-9a-f][0-9a-f]{0,15})(?:\\.(?:0|[1-9a-f][0-9a-f]{0,15})){1,2}$"
    },
    "Address": {
      "description": "完整结构化地址；type 与 node/local 必须一致：system=node≥1,local=0；session/subagent=node≥1,local≥1；group=node=0,local≥1（local=1 为组织广播）。",
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "const": 1
        },
        "realm": {
          "$ref": "#/$defs/PositiveUint64"
        },
        "type": {
          "$ref": "#/$defs/AddressType"
        },
        "node": {
          "$ref": "#/$defs/Uint64"
        },
        "local": {
          "$ref": "#/$defs/Uint64"
        }
      },
      "required": [
        "version",
        "realm",
        "type",
        "node",
        "local"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "system"
              }
            }
          },
          "then": {
            "properties": {
              "node": {
                "$ref": "#/$defs/PositiveUint64"
              },
              "local": {
                "const": "0"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "session",
                  "subagent"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "node": {
                "$ref": "#/$defs/PositiveUint64"
              },
              "local": {
                "$ref": "#/$defs/PositiveUint64"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "group"
              }
            }
          },
          "then": {
            "properties": {
              "node": {
                "const": "0"
              },
              "local": {
                "$ref": "#/$defs/PositiveUint64"
              }
            }
          }
        }
      ]
    },
    "SourceAddress": {
      "description": "from/reply_to 角色：真实 DSH 的 system/session/subagent，禁止 group。",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/Address"
        },
        {
          "properties": {
            "type": {
              "enum": [
                "system",
                "session",
                "subagent"
              ]
            }
          }
        }
      ]
    },
    "NodeAddress": {
      "description": "单播目的、recipient、assigned_address 等指向真实 node 的地址，禁止 group。",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/SourceAddress"
        }
      ]
    },
    "SessionAddress": {
      "description": "非系统会话地址（CONTACT_ASSIGN 分配结果等）。",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/Address"
        },
        {
          "properties": {
            "type": {
              "enum": [
                "session",
                "subagent"
              ]
            }
          }
        }
      ]
    },
    "SystemAddress": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/Address"
        },
        {
          "properties": {
            "type": {
              "const": "system"
            }
          }
        }
      ]
    },
    "GroupAddress": {
      "description": "总部组空间；local=1 为隐式组织广播，普通组 local≥2。",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/Address"
        },
        {
          "properties": {
            "type": {
              "const": "group"
            }
          }
        }
      ]
    },
    "DestinationAddress": {
      "description": "to 角色：任意合法地址（含 group）。",
      "$ref": "#/$defs/Address"
    },
    "NodeRef": {
      "description": "邮箱项的目标 node（realm+node）。",
      "type": "object",
      "properties": {
        "realm": {
          "$ref": "#/$defs/PositiveUint64"
        },
        "node": {
          "$ref": "#/$defs/PositiveUint64"
        }
      },
      "required": [
        "realm",
        "node"
      ],
      "additionalProperties": false
    }
  },
  "$ref": "#/$defs/Address"
}
