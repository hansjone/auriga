{
  "description": "以 frames.json 合法帧为底按 ops 顺序改写后的判定用例。mode：ingress=总部入口对已盖章 message 的检查（认证源 node=63）；downstream=接收方插件对下行帧的检查；receipt=总部对上行 RECEIPT 的检查；schema=生产方 schema 自测。ops：set/remove 路径（点号分隔、数字为下标），seal=重算 message_digest 与签名，seal_keep_digest=只重签，fill/repeat 生成大数组/长串，copy 复制另一合法帧，noncanonical_sig/reorder 见测试。expect 为期望错误码，null 表示必须接受。",
  "cases": [
    { "name": "伪造 from 为他 node", "mode": "ingress", "base": "delivery_session_message", "ops": [{ "set": "from.node", "value": "65" }, { "set": "reply_to.node", "value": "65" }], "expect": "network.sender_mismatch" },
    { "name": "组地址作源", "mode": "ingress", "base": "delivery_session_message", "ops": [{ "set": "from", "value": { "version": 1, "realm": "2", "type": "group", "node": "0", "local": "23" } }, { "set": "reply_to", "value": { "version": 1, "realm": "2", "type": "group", "node": "0", "local": "23" } }], "expect": "network.sender_mismatch" },
    { "name": "广播地址作源", "mode": "ingress", "base": "delivery_session_message", "ops": [{ "set": "from", "value": { "version": 1, "realm": "2", "type": "group", "node": "0", "local": "1" } }, { "set": "reply_to", "value": { "version": 1, "realm": "2", "type": "group", "node": "0", "local": "1" } }], "expect": "network.sender_mismatch" },
    { "name": "第三方 reply_to 重定向", "mode": "ingress", "base": "delivery_session_message", "ops": [{ "set": "reply_to.local", "value": "419" }], "expect": "network.sender_mismatch" },
    { "name": "会话自报 human", "mode": "ingress", "base": "delivery_session_message", "ops": [{ "set": "sender_kind", "value": "human" }], "expect": "network.sender_mismatch" },
    { "name": "agent 冒用 sys 来源", "mode": "ingress", "base": "delivery_session_message", "ops": [{ "set": "from", "value": { "version": 1, "realm": "2", "type": "system", "node": "63", "local": "0" } }, { "set": "reply_to", "value": { "version": 1, "realm": "2", "type": "system", "node": "63", "local": "0" } }], "expect": "network.sender_mismatch" },
    { "name": "组目的声称单播", "mode": "ingress", "base": "delivery_session_message", "ops": [{ "set": "to", "value": { "version": 1, "realm": "2", "type": "group", "node": "0", "local": "23" } }], "expect": "network.class_mismatch" },
    { "name": "广播目的声称组播", "mode": "ingress", "base": "delivery_broadcast", "ops": [{ "set": "message_class", "value": "multicast" }], "expect": "network.class_mismatch" },
    { "name": "单播目的声称广播", "mode": "ingress", "base": "delivery_session_message", "ops": [{ "set": "message_class", "value": "broadcast" }], "expect": "network.class_mismatch" },
    { "name": "控制类走组播", "mode": "ingress", "base": "delivery_multicast", "ops": [{ "set": "kind", "value": "control" }, { "set": "intent", "value": "control" }, { "set": "body", "value": { "subtype": "control", "action": "wake" } }], "expect": "network.dangerous_multicast_forbidden" },
    { "name": "控制类走广播", "mode": "ingress", "base": "delivery_broadcast", "ops": [{ "set": "kind", "value": "control" }, { "set": "intent", "value": "control" }, { "set": "body", "value": { "subtype": "control", "action": "cancel" } }, { "remove": "response_deadline" }], "expect": "network.dangerous_multicast_forbidden" },
    { "name": "组播只把 body 设成控制", "mode": "ingress", "base": "delivery_multicast", "ops": [{ "set": "body", "value": { "subtype": "control", "action": "start" } }], "expect": "network.dangerous_multicast_forbidden" },
    { "name": "单播控制藏在普通 kind 里", "mode": "ingress", "base": "delivery_session_message", "ops": [{ "set": "body", "value": { "subtype": "control", "action": "wake" } }], "expect": "network.protocol_error" },
    { "name": "未知控制动作", "mode": "ingress", "base": "delivery_control_wake", "ops": [{ "set": "body.action", "value": "reboot" }], "expect": "network.protocol_error" },
    { "name": "首联投会话", "mode": "ingress", "base": "delivery_first_contact", "ops": [{ "set": "to", "value": { "version": 1, "realm": "2", "type": "session", "node": "64", "local": "5" } }], "expect": "network.target_mismatch" },
    { "name": "首联投组", "mode": "ingress", "base": "delivery_first_contact", "ops": [{ "set": "to", "value": { "version": 1, "realm": "2", "type": "group", "node": "0", "local": "23" } }, { "set": "message_class", "value": "multicast" }], "expect": "network.target_mismatch" },
    { "name": "agent 发 human_dialogue", "mode": "ingress", "base": "delivery_first_contact", "ops": [{ "set": "contact_scope", "value": "human_dialogue" }], "expect": "network.sender_mismatch" },
    { "name": "首联缺 contact_scope", "mode": "ingress", "base": "delivery_first_contact", "ops": [{ "remove": "contact_scope" }], "expect": "network.protocol_error" },
    { "name": "普通消息夹带组邀请", "mode": "ingress", "base": "delivery_session_message", "ops": [{ "set": "body", "value": { "subtype": "group_invitation", "group_address": { "version": 1, "realm": "2", "type": "group", "node": "0", "local": "23" }, "invitation_id": "inv-1", "invite_expires_at": "2026-10-26T00:00:00Z" } }], "expect": "network.protocol_error" },
    { "name": "回复缺 in_reply_to", "mode": "ingress", "base": "delivery_reply_private", "ops": [{ "set": "in_reply_to", "value": null }], "expect": "network.target_mismatch" },
    { "name": "reply_mode=group 却投单个会话", "mode": "ingress", "base": "delivery_reply_private", "ops": [{ "set": "reply_mode", "value": "group" }], "expect": "network.target_mismatch" },
    { "name": "无授予广播", "mode": "ingress", "base": "delivery_broadcast", "ops": [{ "set": "authorization_ref.broadcast_grant_id", "value": null }], "expect": "network.broadcast_forbidden" },
    { "name": "控制类 ephemeral", "mode": "ingress", "base": "delivery_control_wake", "ops": [{ "set": "durability", "value": "ephemeral" }], "expect": "network.protocol_error" },
    { "name": "普通正文 ephemeral", "mode": "ingress", "base": "delivery_session_message", "ops": [{ "set": "durability", "value": "ephemeral" }, { "set": "intent", "value": "information" }], "expect": "network.protocol_error" },
    { "name": "组播进度 ephemeral 合法", "mode": "ingress", "base": "delivery_multicast", "ops": [{ "set": "durability", "value": "ephemeral" }, { "remove": "dispatch_mode" }, { "set": "body", "value": { "subtype": "progress", "revision": "3", "state": "running" } }], "expect": null },
    { "name": "缺目标", "mode": "ingress", "base": "delivery_session_message", "ops": [{ "remove": "to" }], "expect": "network.target_required" },
    { "name": "外域目标", "mode": "ingress", "base": "delivery_session_message", "ops": [{ "set": "to.realm", "value": "3" }], "expect": "network.realm_not_supported" },
    { "name": "未来地址版本", "mode": "ingress", "base": "delivery_session_message", "ops": [{ "set": "to.version", "value": 2 }], "expect": "network.unsupported_address_version" },
    { "name": "地址补零", "mode": "ingress", "base": "delivery_session_message", "ops": [{ "set": "to.node", "value": "064" }], "expect": "network.invalid_address" },
    { "name": "地址用 JSON number", "mode": "ingress", "base": "delivery_session_message", "ops": [{ "set": "to.node", "value": 64 }], "expect": "network.invalid_address" },
    { "name": "local uint64 溢出", "mode": "ingress", "base": "delivery_session_message", "ops": [{ "set": "to.local", "value": "18446744073709551616" }], "expect": "network.invalid_address" },
    { "name": "local uint64 最大值合法", "mode": "ingress", "base": "delivery_session_message", "ops": [{ "set": "to.local", "value": "18446744073709551615" }], "expect": null },
    { "name": "改 type 把系统地址当组", "mode": "ingress", "base": "delivery_session_message", "ops": [{ "set": "to", "value": { "version": 1, "realm": "2", "type": "group", "node": "64", "local": "0" } }], "expect": "network.invalid_address" },
    { "name": "正文 JCS 恰为 16KiB", "mode": "ingress", "base": "delivery_session_message", "ops": [{ "repeat": "body.text", "char": "a", "count": 16356 }], "expect": null },
    { "name": "正文超 16KiB（ASCII）", "mode": "ingress", "base": "delivery_session_message", "ops": [{ "repeat": "body.text", "char": "a", "count": 16357 }], "expect": "network.protocol_error" },
    { "name": "正文按字节超限（多字节字符）", "mode": "ingress", "base": "delivery_session_message", "ops": [{ "repeat": "body.text", "char": "长", "count": 6000 }], "expect": "network.protocol_error" },
    { "name": "未知 kind", "mode": "ingress", "base": "delivery_session_message", "ops": [{ "set": "kind", "value": "invite" }], "expect": "network.protocol_error" },
    { "name": "ttl 超过 7 天", "mode": "ingress", "base": "delivery_session_message", "ops": [{ "set": "ttl", "value": 604801 }], "expect": "network.protocol_error" },
    { "name": "ttl 用字符串", "mode": "ingress", "base": "delivery_session_message", "ops": [{ "set": "ttl", "value": "86400" }], "expect": "network.protocol_error" },
    { "name": "expires_at 超出 ttl", "mode": "ingress", "base": "delivery_session_message", "ops": [{ "set": "ttl", "value": 60 }], "expect": "network.protocol_error" },
    { "name": "生产方写未知顶层字段", "mode": "ingress", "base": "delivery_session_message", "ops": [{ "set": "x_future", "value": 1 }], "expect": "network.protocol_error" },
    { "name": "thread_sequence 溢出", "mode": "ingress", "base": "delivery_session_message", "ops": [{ "set": "thread_sequence", "value": "18446744073709551616" }], "expect": "network.protocol_error" },

    { "name": "正文被改且未重签", "mode": "downstream", "base": "delivery_session_message", "ops": [{ "set": "message.body.text", "value": "被替换的正文" }], "expect": "network.signature_invalid" },
    { "name": "重签但 message_digest 未更新", "mode": "downstream", "base": "delivery_session_message", "ops": [{ "set": "message.body.text", "value": "被替换的正文" }, { "seal": "keep_digest" }], "expect": "network.sender_mismatch" },
    { "name": "伪造 source_context 来源 node", "mode": "downstream", "base": "delivery_session_message", "ops": [{ "set": "source_context.node", "value": "65" }, { "seal": true }], "expect": "network.sender_mismatch" },
    { "name": "from 与盖章来源不一致", "mode": "downstream", "base": "delivery_session_message", "ops": [{ "set": "message.from.node", "value": "65" }, { "set": "message.reply_to.node", "value": "65" }, { "seal": true }], "expect": "network.sender_mismatch" },
    { "name": "盖章 sender_kind 与消息不一致", "mode": "downstream", "base": "delivery_session_message", "ops": [{ "set": "source_context.sender_kind", "value": "human" }, { "seal": true }], "expect": "network.sender_mismatch" },
    { "name": "缺 server_auth", "mode": "downstream", "base": "delivery_session_message", "ops": [{ "remove": "server_auth" }], "expect": "network.signature_required" },
    { "name": "未知 kid", "mode": "downstream", "base": "delivery_session_message", "ops": [{ "set": "server_auth.kid", "value": "test-r2-unknown" }], "expect": "network.key_unavailable" },
    { "name": "alg=none", "mode": "downstream", "base": "delivery_session_message", "ops": [{ "set": "server_auth.alg", "value": "none" }], "expect": "network.signature_invalid" },
    { "name": "用协议响应用途密钥签业务投递", "mode": "downstream", "base": "delivery_session_message", "ops": [{ "set": "server_auth.purpose", "value": "protocol_response" }, { "set": "server_auth.kid", "value": "test-r2-protocol-1" }, { "seal": true }], "expect": "network.signature_invalid" },
    { "name": "跨 node 重放真签名", "mode": "downstream", "base": "delivery_session_message", "context": { "node": "65" }, "ops": [], "expect": "network.signature_invalid" },
    { "name": "受众 node 被改并重签", "mode": "downstream", "base": "delivery_session_message", "ops": [{ "set": "server_auth.audience.node", "value": "65" }, { "seal": true }], "expect": "network.signature_invalid" },
    { "name": "旧世代页", "mode": "downstream", "base": "delivery_session_message", "context": { "epoch": "43" }, "ops": [], "expect": "network.signature_invalid" },
    { "name": "跨请求重放", "mode": "downstream", "base": "delivery_session_message", "context": { "requestId": "req-fetch-0002" }, "ops": [], "expect": "network.signature_invalid" },
    { "name": "旧 channel_nonce", "mode": "downstream", "base": "delivery_session_message", "context": { "channelNonce": "nonce-ready-0002" }, "ops": [], "expect": "network.signature_invalid" },
    { "name": "封装已过期", "mode": "downstream", "base": "delivery_session_message", "context": { "now": "2026-10-25T00:05:01Z" }, "ops": [], "expect": "network.signature_invalid" },
    { "name": "签发时间在 60 秒容差内的未来", "mode": "downstream", "base": "delivery_session_message", "context": { "now": "2026-10-24T23:59:00Z" }, "ops": [], "expect": null },
    { "name": "签发时间超出时钟容差", "mode": "downstream", "base": "delivery_session_message", "context": { "now": "2026-10-24T23:58:59Z" }, "ops": [], "expect": "network.signature_invalid" },
    { "name": "封装有效期超过 5 分钟", "mode": "downstream", "base": "delivery_session_message", "ops": [{ "set": "server_auth.not_after", "value": "2026-10-25T00:05:01Z" }, { "seal": true }], "expect": "network.signature_invalid" },
    { "name": "封装晚于业务 expires_at", "mode": "downstream", "base": "delivery_session_message", "ops": [{ "set": "message.ttl", "value": 180 }, { "set": "message.expires_at", "value": "2026-10-25T00:03:00Z" }, { "seal": true }], "expect": "network.signature_invalid" },
    { "name": "非规范 base64url 签名", "mode": "downstream", "base": "delivery_session_message", "ops": [{ "noncanonical_sig": "server_auth.signature" }], "expect": "network.signature_invalid" },
    { "name": "对象键重排不影响验签", "mode": "downstream", "base": "delivery_session_message", "ops": [{ "reorder": "" }, { "reorder": "message" }, { "reorder": "server_auth" }], "expect": null },
    { "name": "消费方保留未知字段并验签通过", "mode": "downstream", "consumer": true, "base": "delivery_session_message", "ops": [{ "set": "message.x_future", "value": { "a": 1 } }, { "set": "message.ext", "value": { "e2e_signature": null, "com.example.trace": "t-1" } }, { "seal": true }], "expect": null },
    { "name": "丢弃未知字段后验签失败", "mode": "downstream", "consumer": true, "base": "delivery_session_message", "ops": [{ "set": "message.x_future", "value": { "a": 1 } }, { "seal": true }, { "remove": "message.x_future" }], "expect": "network.signature_invalid" },
    { "name": "未知非关键 flag 保留忽略", "mode": "downstream", "consumer": true, "base": "delivery_session_message", "ops": [{ "set": "message.flags", "value": ["future_hint"] }, { "seal": true }], "expect": null },
    { "name": "非空 e2e_signature 无信任效力但不拒绝", "mode": "downstream", "consumer": true, "base": "delivery_session_message", "ops": [{ "set": "message.ext.e2e_signature", "value": { "alg": "future", "value": "x" } }, { "seal": true }], "expect": null },
    { "name": "未知 kind 消费方仍拒绝", "mode": "downstream", "consumer": true, "base": "delivery_session_message", "ops": [{ "set": "message.kind", "value": "invite" }, { "seal": true }], "expect": "network.protocol_error" },
    { "name": "总部误签组播控制，接收方仍拒", "mode": "downstream", "base": "delivery_multicast", "ops": [{ "set": "message.kind", "value": "control" }, { "set": "message.intent", "value": "control" }, { "set": "message.body", "value": { "subtype": "control", "action": "wake" } }, { "seal": true }], "expect": "network.dangerous_multicast_forbidden" },
    { "name": "下行组地址作源", "mode": "downstream", "base": "delivery_session_message", "ops": [{ "set": "message.from", "value": { "version": 1, "realm": "2", "type": "group", "node": "0", "local": "23" } }, { "set": "message.reply_to", "value": { "version": 1, "realm": "2", "type": "group", "node": "0", "local": "23" } }, { "seal": true }], "expect": "network.sender_mismatch" },
    { "name": "广播投到会话 recipient", "mode": "downstream", "base": "delivery_broadcast", "ops": [{ "set": "recipients.0", "value": { "recipient_id": "rcp-x", "local": "5", "type": "session", "membership_id": "m-x" } }, { "seal": true }], "expect": "network.protocol_error" },
    { "name": "组播缺 membership_id", "mode": "downstream", "base": "delivery_multicast", "ops": [{ "remove": "recipients.1.membership_id" }, { "seal": true }], "expect": "network.protocol_error" },
    { "name": "组播缺 snapshot_id", "mode": "downstream", "base": "delivery_multicast", "ops": [{ "remove": "snapshot_id" }, { "seal": true }], "expect": "network.protocol_error" },
    { "name": "同项重复 recipient", "mode": "downstream", "base": "delivery_multicast", "ops": [{ "set": "recipients.1.recipient_id", "value": "rcp-group-a" }, { "seal": true }], "expect": "network.protocol_error" },
    { "name": "单 node 项超过 256 个 local", "mode": "downstream", "base": "delivery_multicast", "ops": [{ "fill": "recipients", "count": 257, "template": { "recipient_id": "rcp-{i}", "local": "{i1}", "type": "session", "membership_id": "m-{i}" } }, { "seal": true }], "expect": "network.protocol_error" },
    { "name": "单播项多个 recipient", "mode": "downstream", "base": "delivery_session_message", "ops": [{ "set": "recipients.1", "value": { "recipient_id": "rcp-0002", "local": "6", "type": "session" } }, { "seal": true }], "expect": "network.protocol_error" },
    { "name": "投给其他 node 的邮箱项", "mode": "downstream", "base": "delivery_session_message", "ops": [{ "set": "target_node.node", "value": "65" }, { "seal": true }], "expect": "network.signature_invalid" },
    { "name": "mail_seq 溢出", "mode": "downstream", "base": "delivery_session_message", "ops": [{ "set": "mail_seq", "value": "18446744073709551616" }, { "seal": true }], "expect": "network.protocol_error" },
    { "name": "应用主版本不兼容", "mode": "downstream", "base": "delivery_session_message", "ops": [{ "set": "app_version", "value": "2.0" }, { "seal": true }], "expect": "network.unsupported_app_version" },
    { "name": "首联正文缺 contact 状态", "mode": "downstream", "base": "delivery_first_contact", "ops": [{ "remove": "contact" }, { "seal": true }], "expect": "network.protocol_error" },
    { "name": "页面删掉一项", "mode": "downstream", "base": "fetch_result", "ops": [{ "remove": "items.1" }], "expect": "network.signature_invalid" },
    { "name": "页面换入另一条真签名项", "mode": "downstream", "base": "fetch_result", "ops": [{ "copy": "items.1", "from": "delivery_reply_private" }], "expect": "network.signature_invalid" },
    { "name": "页内条目属于另一请求", "mode": "downstream", "base": "fetch_result", "ops": [{ "set": "items.0.server_auth.request_id", "value": "req-fetch-9999" }, { "seal": true }], "expect": "network.signature_invalid" },
    { "name": "篡改页头 committed_cursor", "mode": "downstream", "base": "fetch_result", "ops": [{ "set": "page.committed_cursor", "value": "1206" }], "expect": "network.signature_invalid" },
    { "name": "收件桶总和不等于成员数", "mode": "downstream", "base": "status_full", "ops": [{ "set": "receipts.accepted", "value": "98" }, { "seal": true }], "expect": "network.protocol_error" },
    { "name": "quarantined 超出 pending", "mode": "downstream", "base": "status_full", "ops": [{ "set": "quarantined", "value": "3" }, { "seal": true }], "expect": "network.protocol_error" },
    { "name": "回应桶总和不等于成员数", "mode": "downstream", "base": "status_full", "ops": [{ "set": "responses.pending", "value": "59" }, { "seal": true }], "expect": "network.protocol_error" },
    { "name": "受限回执泄露 message_id", "mode": "downstream", "base": "status_restricted", "ops": [{ "set": "message_id", "value": "msg-0001" }, { "seal": true }], "expect": "network.protocol_error" },
    { "name": "要求未知必需能力", "mode": "downstream", "base": "ready_result", "ops": [{ "set": "required_features", "value": ["server_auth_v1", "e2e_required_v1"] }, { "seal": true }], "expect": "network.unsupported_app_version" },
    { "name": "下发仅本地诊断错误码", "mode": "downstream", "base": "error", "ops": [{ "set": "code", "value": "network.signature_invalid" }, { "seal": true }], "expect": "network.protocol_error" },
    { "name": "下发未定义错误码", "mode": "downstream", "base": "error", "ops": [{ "set": "code", "value": "network.not_a_code" }, { "seal": true }], "expect": "network.protocol_error" },
