              "required": [
                "issued_at",
                "before",
                "grace_seconds",
                "removed",
                "tombstones",
                "reappeared"
              ],
              "additionalProperties": false
            }
          },
          "required": ["id", "operation", "expected", "input"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "operation": {
              "const": "config"
            },
            "expected": {
              "type": "string",
              "enum": [
                "accept",
                "authority_revoked",
                "authority_unknown",
                "control_rollback",
                "control_required",
                "version_rollback",
