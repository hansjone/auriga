                    },
                    "projector_identity_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "projection_directory": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "reload_seconds": {
                      "type": "number"
                    },
                    "leaf_days": {
                      "type": "number"
