              "properties": {
                "config": {
                  "type": "object",
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "kek_secret_file": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "kek_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "authority_source": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "control_source": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "keyset_seconds": {
                      "type": "number"
                    },
                    "refresh_seconds": {
                      "type": "number"
                    },
                    "check_seconds": {
                      "type": "number"
                    },
                    "business_key_seconds": {
                      "type": "number"
                    },
                    "rotation_seconds": {
                      "type": "number"
                    },
                    "preannounce_seconds": {
                      "type": "number"
                    },
                    "maturity_seconds": {
                      "type": "number"
                    },
                    "overlap_seconds": {
                      "type": "number"
                    },
                    "allowed_skew_seconds": {
                      "type": "number"
                    },
                    "review_period_days": {
                      "type": "integer"
                    },
                    "review_reminder_days": {
                      "type": "array",
                      "items": {
                        "type": "integer"
                      },
                      "minItems": 3,
