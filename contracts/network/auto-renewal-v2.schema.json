        },
        "history_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "before",
        "history_digest"
      ],
      "additionalProperties": false
    },
    "KeysetPayload": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 2
        },
        "tenant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "realm": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "authority_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "authority_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "control_revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "generation": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "keyset_version": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "issued_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "$comment": "auriga-preserve-signature-text"
        },
        "valid_until": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "$comment": "auriga-preserve-signature-text"
        },
        "mode": {
          "type": "string",
          "enum": [
            "bootstrap",
            "refresh",
            "activate",
            "restart_recovery",
            "migration",
            "authority_transition"
          ]
        },
        "keys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PublicKey"
          },
          "maxItems": 128
        },
        "first_publications": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FirstPublication"
          },
          "maxItems": 128
        },
        "archive": {
          "$ref": "#/$defs/Archive"
        }
      },
      "required": [
        "schema_version",
        "tenant_id",
        "realm",
        "authority_id",
        "authority_digest",
        "control_revision",
        "generation",
        "keyset_version",
        "issued_at",
        "valid_until",
        "mode",
        "keys",
        "first_publications",
        "archive"
      ],
      "additionalProperties": false
    },
    "SignedKeysetV2": {
      "type": "object",
      "properties": {
        "payload": {
          "$ref": "#/$defs/KeysetPayload"
        },
        "runtime_auth": {
          "$ref": "#/$defs/Signature"
        }
      },
