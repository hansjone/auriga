{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auriga.example.com/contracts/network/auto-renewal-v2.schema.json",
  "title": "Auriga 消息网络自动续期 v2",
  "description": "严格受签对象，拒绝未知字段和重复键。跨字段规则见 auto-renewal-v2.md。整数序列为十进制字符串，须检查 uint64 上界。",
  "$defs": {
    "Signature": {
      "type": "object",
      "properties": {
        "alg": {
          "const": "Ed25519"
        },
        "kid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{85}[AQgw]$"
        }
      },
      "required": [
        "alg",
        "kid",
        "signature"
      ],
      "additionalProperties": false
    },
    "Limits": {
      "type": "object",
      "properties": {
        "keyset_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "business_key_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 691200
        },
        "restart_key_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 604800
        },
        "next_maturity_seconds": {
          "type": "integer",
          "minimum": 86400,
          "maximum": 2147483647
        },
        "overlap_seconds": {
          "type": "integer",
          "minimum": 360,
          "maximum": 2147483647
        },
        "archive_grace_seconds": {
          "type": "integer",
          "minimum": 360,
          "maximum": 2147483647
        }
      },
      "required": [
        "keyset_seconds",
        "business_key_seconds",
        "restart_key_seconds",
        "next_maturity_seconds",
        "overlap_seconds",
        "archive_grace_seconds"
      ],
      "additionalProperties": false
    },
    "TransportScope": {
      "type": "object",
      "properties": {
        "component": {
          "type": "string",
          "enum": [
            "network",
            "edge",
            "broker"
          ]
        },
        "identity_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sans": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "maxItems": 32
        },
        "ekus": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "serverAuth",
              "clientAuth"
            ]
          },
          "maxItems": 2
        }
      },
      "required": [
        "component",
        "identity_id",
        "sans",
        "ekus"
      ],
      "additionalProperties": false
    },
    "RuntimeAuthority": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 2
        },
        "tenant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "realm": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "authority_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "authority_revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "runtime_kid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "public_key_spki": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{59}$"
        },
        "not_before": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "$comment": "auriga-preserve-signature-text"
        },
        "expiry_policy": {
          "const": "no_hard_expiry"
        },
        "review_period_days": {
          "const": 365
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "keyset",
              "announcement",
              "business_rotation",
              "restart_recovery",
              "history_archive",
              "network_transport"
            ]
          },
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true
        },
        "limits": {
          "$ref": "#/$defs/Limits"
        },
        "transport_scope": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TransportScope"
          },
          "maxItems": 32
        }
      },
      "required": [
        "schema_version",
        "tenant_id",
        "realm",
        "authority_id",
        "authority_revision",
        "runtime_kid",
        "public_key_spki",
        "not_before",
        "expiry_policy",
        "review_period_days",
        "capabilities",
        "limits",
        "transport_scope"
      ],
      "additionalProperties": false
    },
    "AuthorityReference": {
      "type": "object",
      "properties": {
        "authority_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "authority_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "authority_id",
        "authority_digest"
      ],
      "additionalProperties": false
    },
    "RootControl": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 2
        },
        "tenant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "realm": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "control_revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "issued_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "$comment": "auriga-preserve-signature-text"
        },
        "allowed_authorities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AuthorityReference"
          },
          "maxItems": 32
        },
        "revoked_authority_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "maxItems": 65536
        },
        "revoked_installation_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "maxItems": 65536
        },
        "minimum_generation": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "minimum_keyset_version": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "generation_transition": {
          "$ref": "#/$defs/GenerationTransition"
        }
      },
      "required": [
        "schema_version",
        "tenant_id",
        "realm",
        "control_revision",
        "issued_at",
        "allowed_authorities",
        "revoked_authority_ids",
        "revoked_installation_ids",
        "minimum_generation",
        "minimum_keyset_version"
      ],
      "additionalProperties": false
    },
    "SignedRuntimeAuthority": {
      "type": "object",
      "properties": {
        "payload": {
          "$ref": "#/$defs/RuntimeAuthority"
        },
        "root_auth": {
          "$ref": "#/$defs/Signature"
        }
      },
      "required": [
        "payload",
        "root_auth"
      ],
      "additionalProperties": false
    },
    "SignedRootControl": {
      "type": "object",
      "properties": {
        "payload": {
          "$ref": "#/$defs/RootControl"
        },
        "root_auth": {
          "$ref": "#/$defs/Signature"
        }
      },
      "required": [
        "payload",
        "root_auth"
      ],
      "additionalProperties": false
    },
    "PublicKey": {
      "type": "object",
      "properties": {
        "kid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "alg": {
          "const": "Ed25519"
        },
        "purpose": {
          "type": "string",
          "enum": [
            "business_delivery",
            "protocol_response",
            "management_state"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "active",
            "next",
            "retired",
            "revoked"
          ]
        },
        "not_before": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "$comment": "auriga-preserve-signature-text"
        },
        "not_after": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "$comment": "auriga-preserve-signature-text"
        },
        "public_key_spki": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{59}$"
        }
      },
      "required": [
        "kid",
        "alg",
        "purpose",
        "state",
        "not_before",
        "not_after",
        "public_key_spki"
      ],
      "additionalProperties": false
    },
    "FirstPublication": {
      "type": "object",
      "properties": {
        "kid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "committed_version": {
          "type": "string",
