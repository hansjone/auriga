{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auriga.example.com/contracts/runtime/standalone.schema.json",
  "title": "Standalone ArtifactStatement 七字段映射",
  "$defs": {
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "Time": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{0,8}[1-9])?Z$"
    }
  },
  "type": "object",
  "properties": {
    "purpose": {
      "type": "string",
      "enum": ["agent", "dsh_runtime", "plugin"]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "os": {
      "type": "string",
      "enum": ["linux", "windows", "any"]
    },
    "arch": {
      "type": "string",
      "enum": ["amd64", "arm64", "any"]
    },
    "digest": {
      "$ref": "#/$defs/Digest"
    },
    "issuedAt": {
      "$ref": "#/$defs/Time"
    }
  },
  "required": [
    "purpose",
    "name",
    "version",
    "os",
    "arch",
    "digest",
    "issuedAt"
  ],
  "additionalProperties": false
}
