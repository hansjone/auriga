{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auriga.example.com/contracts/runtime/release.schema.json",
  "title": "RuntimeReleaseEnvelope v1",
  "description": "严格受签 JSON 映射；跨消息、OCI、本地策略和高水位见 README.md。",
  "$defs": {
    "Kid": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,128}$"
    },
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "Time": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{0,8}[1-9])?Z$"
    },
    "Signature": {
      "type": "object",
      "properties": {
        "alg": {
          "const": "Ed25519",
          "type": "string"
        },
        "kid": {
          "$ref": "#/$defs/Kid"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{85}[AQgw]$"
        }
      },
      "required": ["alg", "kid", "value"],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "purpose": {
      "type": "string",
      "const": "dsh_runtime"
    },
    "name": {
      "type": "string",
      "const": "dsh"
    },
    "artifactId": {
      "type": "string",
      "minLength": 1
    },
    "dshVersion": {
      "type": "string",
      "minLength": 1
    },
    "os": {
      "type": "string",
      "enum": ["linux", "windows"]
    },
    "arch": {
      "type": "string",
      "enum": ["amd64", "arm64"]
    },
    "archiveDigest": {
      "anyOf": [
        {
          "$ref": "#/$defs/Digest"
        },
        {
          "type": "string",
          "const": ""
        }
      ]
    },
    "imageDigest": {
      "anyOf": [
        {
          "$ref": "#/$defs/Digest"
        },
        {
          "type": "string",
          "const": ""
        }
      ]
    },
    "releaseSequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "issuedAt": {
      "$ref": "#/$defs/Time"
    },
    "signature": {
      "$ref": "#/$defs/Signature"
    }
  },
  "required": [
    "schemaVersion",
    "purpose",
    "name",
    "artifactId",
    "dshVersion",
    "os",
    "arch",
    "archiveDigest",
    "imageDigest",
    "releaseSequence",
    "issuedAt",
    "signature"
  ],
  "additionalProperties": false,
  "anyOf": [
    {
      "properties": {
        "archiveDigest": {
          "$ref": "#/$defs/Digest"
        }
      }
    },
    {
      "properties": {
        "imageDigest": {
          "$ref": "#/$defs/Digest"
        }
      }
    }
  ]
}
