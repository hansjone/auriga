<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>auriga</groupId>
    <artifactId>auriga</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>contracts</artifactId>
  <properties>
    <!-- Go model regeneration is explicit: ordinary Java verification must not mutate tracked Go files. -->
    <auriga.skipGoModels>true</auriga.skipGoModels>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.google.protobuf</groupId>
      <artifactId>protobuf-java</artifactId>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-protobuf</artifactId>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-stub</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>jakarta.validation</groupId>
      <artifactId>jakarta.validation-api</artifactId>
    </dependency>
    <dependency>
      <groupId>jakarta.annotation</groupId>
      <artifactId>jakarta.annotation-api</artifactId>
    </dependency>
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-annotations</artifactId>
    </dependency>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
  </dependencies>
  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <resource>
        <directory>${project.basedir}/../../contracts</directory>
        <targetPath>auriga/contracts</targetPath>
        <includes>
          <include>catalog/m3.json</include>
        </includes>
      </resource>
    </resources>
    <testResources>
      <testResource>
        <directory>${project.basedir}/../../contracts/resource</directory>
        <includes>
          <include>signature-vectors.json</include>
        </includes>
      </testResource>
    </testResources>
    <extensions>
      <extension>
        <groupId>kr.motd.maven</groupId>
        <artifactId>os-maven-plugin</artifactId>
        <version>1.7.1</version>
      </extension>
    </extensions>
    <plugins>
      <plugin>
        <groupId>com.github.eirslett</groupId>
        <artifactId>frontend-maven-plugin</artifactId>
        <version>1.15.1</version>
        <configuration>
          <installDirectory>${project.build.directory}</installDirectory>
        </configuration>
        <executions>
          <execution>
            <id>node</id>
            <phase>initialize</phase>
            <goals>
              <goal>install-node-and-npm</goal>
            </goals>
            <configuration>
              <nodeVersion>v22.19.0</nodeVersion>
            </configuration>
          </execution>
          <execution>
            <id>contract-tools</id>
            <phase>initialize</phase>
            <goals>
              <goal>npm</goal>
            </goals>
            <configuration>
              <arguments>ci --ignore-scripts --no-audit --no-fund --cache target/npm-cache</arguments>
            </configuration>
          </execution>
          <execution>
            <id>bundle-openapi</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>npm</goal>
            </goals>
            <configuration>
              <arguments>run bundle</arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.xolstice.maven.plugins</groupId>
        <artifactId>protobuf-maven-plugin</artifactId>
        <version>0.6.1</version>
        <configuration>
          <protoSourceRoot>${project.basedir}/../../contracts/proto</protoSourceRoot>
          <protocArtifact>com.google.protobuf:protoc:${protobuf.version}:exe:${os.detected.classifier}</protocArtifact>
          <pluginId>grpc-java</pluginId>
          <pluginArtifact>io.grpc:protoc-gen-grpc-java:${grpc.version}:exe:${os.detected.classifier}</pluginArtifact>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>compile</goal>
              <goal>compile-custom</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <version>7.26.0</version>
        <configuration>
          <generatorName>spring</generatorName>
          <generateSupportingFiles>false</generateSupportingFiles>
          <generateApiTests>false</generateApiTests>
          <generateModelTests>false</generateModelTests>
          <generateApiDocumentation>false</generateApiDocumentation>
          <generateModelDocumentation>false</generateModelDocumentation>
          <configOptions>
            <interfaceOnly>true</interfaceOnly>
            <useSpringBoot4>true</useSpringBoot4>
            <useJackson3>true</useJackson3>
            <hideGenerationTimestamp>true</hideGenerationTimestamp>
            <useTags>true</useTags>
            <openApiNullable>false</openApiNullable>
            <useSwaggerUI>false</useSwaggerUI>
            <documentationProvider>none</documentationProvider>
            <annotationLibrary>none</annotationLibrary>
            <useResponseEntity>true</useResponseEntity>
            <skipDefaultInterface>true</skipDefaultInterface>
            <useOneOfInterfaces>false</useOneOfInterfaces>
          </configOptions>
        </configuration>
        <executions>
          <execution>
            <id>iam-http</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${project.build.directory}/bundled/iam.json</inputSpec>
              <output>${project.build.directory}/generated-sources/openapi/iam</output>
              <apiPackage>auriga.iam.web.api</apiPackage>
              <modelPackage>auriga.iam.web.model</modelPackage>
            </configuration>
          </execution>
          <execution>
            <id>org-http</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${project.build.directory}/bundled/org.json</inputSpec>
              <output>${project.build.directory}/generated-sources/openapi/org</output>
              <apiPackage>auriga.org.web.api</apiPackage>
              <modelPackage>auriga.org.web.model</modelPackage>
            </configuration>
          </execution>
          <execution>
            <id>workspace-http</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${project.build.directory}/bundled/workspace.json</inputSpec>
              <output>${project.build.directory}/generated-sources/openapi/workspace</output>
              <apiPackage>auriga.workspace.web.api</apiPackage>
              <modelPackage>auriga.workspace.web.model</modelPackage>
            </configuration>
          </execution>
          <execution>
            <id>ai-http</id>
            <goals><goal>generate</goal></goals>
            <configuration>
              <inputSpec>${project.build.directory}/bundled/ai.json</inputSpec>
              <output>${project.build.directory}/generated-sources/openapi/ai</output>
              <apiPackage>auriga.ai.web.api</apiPackage>
              <modelPackage>auriga.ai.web.model</modelPackage>
            </configuration>
          </execution>
          <execution>
            <id>resource-http</id>
            <goals><goal>generate</goal></goals>
            <configuration>
              <inputSpec>${project.build.directory}/bundled/resource.json</inputSpec>
              <output>${project.build.directory}/generated-sources/openapi/resource</output>
              <apiPackage>auriga.resource.web.api</apiPackage>
              <modelPackage>auriga.resource.web.model</modelPackage>
            </configuration>
          </execution>
          <execution>
            <id>ai-go-models</id>
            <goals><goal>generate</goal></goals>
            <configuration>
              <skip>${auriga.skipGoModels}</skip>
              <cleanupOutput>true</cleanupOutput>
              <generatorName>go</generatorName>
              <inputSpec>${project.build.directory}/bundled/ai.json</inputSpec>
              <output>${project.basedir}/../../infra/gen/aiapi</output>
              <generateApis>false</generateApis>
              <generateSupportingFiles>true</generateSupportingFiles>
              <supportingFilesToGenerate>utils.go</supportingFilesToGenerate>
              <generateApiDocumentation>false</generateApiDocumentation>
              <generateModelDocumentation>false</generateModelDocumentation>
              <configOptions>
                <packageName>aiapi</packageName>
                <hideGenerationTimestamp>true</hideGenerationTimestamp>
                <disallowAdditionalPropertiesIfNotPresent>false</disallowAdditionalPropertiesIfNotPresent>
              </configOptions>
            </configuration>
          </execution>
          <execution>
            <id>resource-go-models</id>
            <goals><goal>generate</goal></goals>
            <configuration>
              <skip>${auriga.skipGoModels}</skip>
              <cleanupOutput>true</cleanupOutput>
              <generatorName>go</generatorName>
              <inputSpec>${project.build.directory}/bundled/resource.json</inputSpec>
              <output>${project.basedir}/../../infra/gen/resourceapi</output>
              <generateApis>false</generateApis>
              <generateSupportingFiles>true</generateSupportingFiles>
              <supportingFilesToGenerate>utils.go</supportingFilesToGenerate>
              <generateApiDocumentation>false</generateApiDocumentation>
              <generateModelDocumentation>false</generateModelDocumentation>
              <configOptions>
                <packageName>resourceapi</packageName>
                <hideGenerationTimestamp>true</hideGenerationTimestamp>
                <disallowAdditionalPropertiesIfNotPresent>false</disallowAdditionalPropertiesIfNotPresent>
              </configOptions>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>go-openapi-models</id>
      <properties>
        <auriga.skipGoModels>false</auriga.skipGoModels>
      </properties>
    </profile>
  </profiles>
</project>
