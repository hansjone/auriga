<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>auriga</groupId>
    <artifactId>auriga</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../../pom.xml</relativePath>
  </parent>
  <artifactId>iam-impl</artifactId>
  <dependencies>
    <dependency><groupId>auriga</groupId><artifactId>workspace-api</artifactId><version>${project.version}</version></dependency>
    <!-- Connection-time DNS filtering prevents OIDC SSRF and DNS rebinding. -->
    <dependency><groupId>org.apache.httpcomponents.client5</groupId><artifactId>httpclient5</artifactId></dependency>
    <dependency><groupId>org.bouncycastle</groupId><artifactId>bcprov-jdk18on</artifactId><version>1.83</version></dependency>
    <dependency>
      <groupId>com.yubico</groupId>
      <artifactId>webauthn-server-core</artifactId>
    </dependency>
    <!-- yubico webauthn exposes com.fasterxml.jackson checked exceptions on its JSON helpers -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
    <dependency><groupId>auriga</groupId><artifactId>test-support</artifactId><version>${project.version}</version><scope>test</scope></dependency>
    <dependency>
      <groupId>auriga</groupId>
      <artifactId>iam-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>auriga</groupId>
      <artifactId>common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>auriga</groupId>
      <artifactId>contracts</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-context</artifactId>
    </dependency>
  </dependencies>
  <build>
    <resources>
      <resource><directory>src/main/resources</directory></resource>
      <resource><directory>${project.basedir}/../../../contracts</directory><targetPath>auriga/iam/contracts</targetPath><includes><include>identity/*.schema.json</include><include>auth/*.schema.json</include><include>kv/session.schema.json</include><include>network/system-directory.schema.json</include><include>network/register.schema.json</include><include>network/ticket-request.schema.json</include><include>network/envelope.schema.json</include><include>network/address.schema.json</include></includes></resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>service-boundary</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <message>Services may depend on another service's api, never its impl.</message>
                  <searchTransitive>true</searchTransitive>
                  <excludes>
                    <exclude>auriga:*-impl</exclude>
                  </excludes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
