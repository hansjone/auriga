{
  "name": "auriga-dsh",
  "version": "0.0.0",
  "description": "Auriga DSH plugin skeleton",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": "./src/index.js",
  "files": [
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test",
    "build": "tsc --noEmit -p tsconfig.json",
    "gen:steps": "json2ts -i ../../contracts/identity/steps.schema.json -o src/generated/steps.d.ts --unreachableDefinitions && prettier --write src/generated/steps.d.ts"
  },
  "devDependencies": {
    "json-schema-to-typescript": "16.0.0"
  }
}
