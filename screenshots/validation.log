TEST-ONLY ENVIRONMENT PRELOAD (no tracked installer changes; no visible browser launch)
import { setGlobalDispatcher, EnvHttpProxyAgent } from '../clients/dsh-plugin/node_modules/undici/index.js';

import childProcess from 'node:child_process';

import { syncBuiltinESMExports } from 'node:module';

import { readFileSync, writeFileSync } from 'node:fs';

import { resolve, dirname } from 'node:path';

import { fileURLToPath } from 'node:url';

setGlobalDispatcher(new EnvHttpProxyAgent());

const original = childProcess.spawnSync;

childProcess.spawnSync = function(command, args, options) {

  if (/csc(?:\.exe)?$/i.test(String(command)) && Array.isArray(args)) {

    args = args.map(arg => {

      if (!/[\\/]tray[\\/]Tray\.cs$/i.test(arg)) return arg;

      const text = readFileSync(arg, 'utf8');

      const target = 'try { Process.Start(new ProcessStartInfo(target) { UseShellExecute = true }); }';

      if (!text.includes(target)) throw new Error('test browser guard no longer matches');

      const dest = resolve(dirname(fileURLToPath(import.meta.url)), 'guarded-tray-' + process.pid + '.cs');

      writeFileSync(dest, text.replace(target, 'try { System.Diagnostics.Debug.WriteLine(target); }'));

      return dest;

    });

  }

  return original.call(this, command, args, options);

};

syncBuiltinESMExports();

