// Test-only overlay adapter compiled in the unchanged gateway network package.
package network

import (
	"encoding/json"
	"os"
	"testing"
	"time"
)

func TestNASActivatedGatewayProtocolConsumer(t *testing.T) {
	raw, err := os.ReadFile(os.Getenv("AURIGA_NAS_PROTOCOL_INPUT"))
	if err != nil {
		t.Fatal(err)
	}
	var input map[string]string
	if err = json.Unmarshal(raw, &input); err != nil {
		t.Fatal(err)
	}
	read := func(path string) ProtocolSigningConfig {
		t.Helper()
		raw, err := os.ReadFile(path)
		if err != nil {
			t.Fatal(err)
		}
		var runtime struct {
			Signing ProtocolSigningConfig `json:"protocolSigning"`
		}
		if err = json.Unmarshal(raw, &runtime); err != nil {
			t.Fatal(err)
		}
		// Resolve just the container-private path through the actual Engine bind.
		if runtime.Signing.PrivateKeyFile != "/etc/auriga/network/protocol.key" {
			t.Fatal("unexpected consumer key target")
		}
		runtime.Signing.PrivateKeyFile = input["privateKey"]
		return runtime.Signing
	}
	good := read(input["runtime"])
	mixed := read(input["legacyRuntime"])
	if mixed.KeyID == good.KeyID {
		t.Fatal("test did not promote a different protocol key")
	}
	binding := liveBinding{Realm: "1", Node: "2", Incarnation: "inc", ChannelNonce: "nonce", Epoch: 1, NotAfter: time.Now().Add(time.Minute)}
	encode := func(cfg ProtocolSigningConfig) json.RawMessage {
		t.Helper()
		signer, err := newErrorSigner(cfg)
		if err != nil {
			t.Fatal(err)
		}
		defer clear(signer.key)
		frame, err := signer.encode(binding, "req", &AppError{Code: CodeProtocolError, Scope: "request"})
		if err != nil {
			t.Fatal(err)
		}
		return frame
	}
	frames := map[string]json.RawMessage{"good": encode(good), "mixed": encode(mixed)}
	expired := mixed
	expired.NotAfter = time.Now().Add(-time.Second).UTC().Format(time.RFC3339)
	if _, err := newErrorSigner(expired); err == nil {
		t.Fatal("expired legacy signing window accepted")
	}
	out, err := json.Marshal(frames)
	if err != nil {
		t.Fatal(err)
	}
	if err = os.WriteFile(input["output"], out, 0600); err != nil {
		t.Fatal(err)
	}
}
