# Build from repository root:
#   docker build -f deploy/nas/docker/Dockerfile.platform --platform=linux/amd64 .
FROM eclipse-temurin:25-jdk AS build
WORKDIR /src
COPY . .
RUN sh .mvn/wrapper/bootstrap.sh
RUN ./mvnw -q -pl services/platform-app -am -DskipTests package

FROM eclipse-temurin:25-jre
RUN apt-get update \
  && apt-get install -y --no-install-recommends curl \
  && rm -rf /var/lib/apt/lists/* \
  && groupadd --gid 10001 auriga \
  && useradd --uid 10001 --gid 10001 --home-dir /app --shell /usr/sbin/nologin auriga \
  && mkdir -p /app/tmp \
  && chown -R 10001:10001 /app
WORKDIR /app
COPY --from=build --chown=10001:10001 /src/services/platform-app/target/platform-app-*-exec.jar /app/platform.jar
EXPOSE 8081 7443
USER 10001:10001
ENTRYPOINT ["java", "-jar", "/app/platform.jar"]
