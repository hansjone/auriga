# Build from repository root:
#   docker build -f deploy/nas/docker/Dockerfile.platform --platform=linux/amd64 .
FROM eclipse-temurin:25-jdk AS build
WORKDIR /src
COPY . .
RUN ./mvnw -q -pl services/platform-app -am -DskipTests package

FROM eclipse-temurin:25-jre
RUN apt-get update \
  && apt-get install -y --no-install-recommends curl \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /src/services/platform-app/target/platform-app-*-exec.jar /app/platform.jar
EXPOSE 8081 7443
# Runs as root in-container so bind-mounted enrollment/PKI modes from init remain usable
# on QNAP without requiring host UID remapping. Not privileged; no host network.
ENTRYPOINT ["java", "-jar", "/app/platform.jar"]
