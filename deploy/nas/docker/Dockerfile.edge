# Build from repository root. Embeds portal + admin static assets for NAS.
#   docker build -f deploy/nas/docker/Dockerfile.edge --platform=linux/amd64 .
FROM node:22-bookworm AS web
WORKDIR /src
COPY package.json pnpm-workspace.yaml .npmrc .prettierrc.json ./
COPY web ./web
COPY clients ./clients
COPY contracts ./contracts
COPY tsconfig.base.json ./
RUN corepack enable \
  && corepack prepare pnpm@11.28.6 --activate \
  && pnpm install --frozen-lockfile \
  && pnpm gen:api \
  && pnpm gen:steps \
  && pnpm --filter @auriga/portal build \
  && pnpm --filter @auriga/admin build \
  && pnpm --filter @auriga/panel build

FROM golang:1.27.3 AS gobuild
WORKDIR /src/infra
COPY infra/ ./
WORKDIR /src/infra/edge
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /out/auriga-edge .
WORKDIR /src/infra/ai-gateway
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /out/auriga-ai-gateway . \
  && CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /out/auriga-network-broker github.com/nats-io/nats-server/v2
WORKDIR /src/deploy/bootstrap
COPY deploy/bootstrap/ ./
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /out/auriga-network-probe ./cmd/network-probe
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /out/auriga-panel ./cmd/panel

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=gobuild /out/auriga-edge /auriga-edge
COPY --from=gobuild /out/auriga-ai-gateway /auriga-ai-gateway
COPY --from=gobuild /out/auriga-network-broker /auriga-network-broker
COPY --from=gobuild /out/auriga-network-probe /auriga-network-probe
COPY --from=gobuild /out/auriga-panel /auriga-panel
COPY --from=web /src/web/panel/dist /srv/auriga/static/panel
COPY --from=web /src/web/portal/dist /srv/auriga/static/portal
COPY --from=web /src/web/admin/dist /srv/auriga/static/admin
USER nonroot:nonroot
ENTRYPOINT ["/auriga-edge"]
