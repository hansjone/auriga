# Auriga NAS test NATS (JetStream). Passwords filled by render.sh — never commit rendered files.
# Monitoring (http) binds loopback only and is not published to the NAS host or LAN.
port: 4222
http: "127.0.0.1:8222"
server_name: auriga-nas-test-nats

jetstream {
  store_dir: /data
  # Disk/RAM caps so a runaway client cannot fill the NAS share (M11).
  max_memory_store: 64MB
  max_file_store: 1GB
}

accounts {
  SYS: {
    users: [{ user: sys, password: "__NATS_SYS_PASSWORD__" }]
  }
  AURIGA: {
    jetstream: enabled
    users: [
      {
        # Platform: events + sessions KV. JS API limited to sessions stream/KV.
        user: platform
        password: "__NATS_PLATFORM_PASSWORD__"
        permissions: {
          publish: { allow: [
            "auriga.evt.>",
            "$KV.auriga-sessions.>",
            "$JS.API.STREAM.CREATE.KV_auriga-sessions",
            "$JS.API.STREAM.UPDATE.KV_auriga-sessions",
            "$JS.API.STREAM.INFO.KV_auriga-sessions",
            "$JS.API.STREAM.LIST",
            "$JS.API.STREAM.NAMES",
            "$JS.API.STREAM.MSG.GET.KV_auriga-sessions",
            "$JS.API.DIRECT.GET.KV_auriga-sessions",
            "$JS.API.DIRECT.GET.KV_auriga-sessions.>",
            "$JS.API.CONSUMER.CREATE.KV_auriga-sessions",
            "$JS.API.CONSUMER.CREATE.KV_auriga-sessions.>",
            "$JS.API.CONSUMER.DURABLE.CREATE.KV_auriga-sessions.>",
            "$JS.API.CONSUMER.INFO.KV_auriga-sessions.>",
            "$JS.API.CONSUMER.MSG.NEXT.KV_auriga-sessions.>",
            "$JS.ACK.KV_auriga-sessions.>",
            "$JS.API.INFO"
          ] }
          subscribe: { allow: [
            "_INBOX.>",
            "auriga.evt.>",
            "$KV.auriga-sessions.>"
          ] }
        }
      }
      {
        # Workspace routes publisher — JS API limited to routes KV/stream.
        user: routes_rw
        password: "__NATS_ROUTES_RW_PASSWORD__"
        permissions: {
          publish: { allow: [
            "$KV.auriga-routes.>",
            "$JS.API.STREAM.CREATE.KV_auriga-routes",
            "$JS.API.STREAM.UPDATE.KV_auriga-routes",
            "$JS.API.STREAM.INFO.KV_auriga-routes",
            "$JS.API.STREAM.LIST",
            "$JS.API.STREAM.NAMES",
            "$JS.API.STREAM.MSG.GET.KV_auriga-routes",
            "$JS.API.DIRECT.GET.KV_auriga-routes",
            "$JS.API.DIRECT.GET.KV_auriga-routes.>",
            "$JS.API.CONSUMER.CREATE.KV_auriga-routes",
            "$JS.API.CONSUMER.CREATE.KV_auriga-routes.>",
            "$JS.API.CONSUMER.DURABLE.CREATE.KV_auriga-routes.>",
            "$JS.API.CONSUMER.INFO.KV_auriga-routes.>",
            "$JS.API.INFO"
          ] }
          subscribe: { allow: ["_INBOX.>", "$KV.auriga-routes.>"] }
        }
      }
      {
        # Edge: sessions + routes read + revoke. Shared natsUrl (password auth).
        # If KV create/ensure-streams needs broader JS on first boot, widen here and document.
        user: edge
        password: "__NATS_EDGE_PASSWORD__"
        permissions: {
          publish: { allow: [
            "$KV.auriga-sessions.>",
            "$JS.API.STREAM.INFO.KV_auriga-routes",
            "$JS.API.STREAM.MSG.GET.KV_auriga-routes",
            "$JS.API.DIRECT.GET.KV_auriga-routes",
            "$JS.API.DIRECT.GET.KV_auriga-routes.>",
            "$JS.API.STREAM.INFO.KV_auriga-sessions",
            "$JS.API.STREAM.MSG.GET.KV_auriga-sessions",
            "$JS.API.DIRECT.GET.KV_auriga-sessions",
            "$JS.API.DIRECT.GET.KV_auriga-sessions.>",
            "$JS.API.STREAM.CREATE.KV_auriga-sessions",
            "$JS.API.CONSUMER.CREATE.KV_auriga-sessions",
            "$JS.API.CONSUMER.CREATE.KV_auriga-sessions.>",
            "$JS.API.CONSUMER.DURABLE.CREATE.KV_auriga-sessions.>",
            "$JS.API.CONSUMER.INFO.KV_auriga-sessions.>",
            "$JS.API.CONSUMER.MSG.NEXT.KV_auriga-sessions.>",
            "$JS.ACK.KV_auriga-sessions.>",
            "$JS.API.INFO"
          ] }
          subscribe: { allow: [
            "_INBOX.>",
            "$KV.auriga-sessions.>",
            "$KV.auriga-routes.>",
            "auriga.evt.identity.session_revoked"
          ] }
        }
      }
    ]
  }
}

system_account: SYS
# Every client must authenticate (anonymous login disabled).
