# HTTPS front proxy for access-proxy.example.json. Public placeholders only.
# Install this deployment's proxy-ca.crt and proxy-client.crt/key on the trusted
# proxy. Client key is private; never copy IAM/NodeControl keys or the proxy CA key.
# Upstream ports MUST match the separate portal/admin TLS listeners in access JSON.
# Preserve full external authority, including non-default ports. The edge derives
# scheme/tenant from the installed access map, never X-Forwarded-*.
# Caddy transport options: https://caddyserver.com/docs/caddyfile/directives/reverse_proxy

(auriga_backend_mtls) {
 transport http {
  tls_server_name edge.auriga.internal
  tls_trust_pool file /etc/caddy/auriga-proxy/proxy-ca.crt
  tls_client_auth /etc/caddy/auriga-proxy/proxy-client.crt /etc/caddy/auriga-proxy/proxy-client.key
  read_timeout 0
  write_timeout 0
 }
 header_up Host {http.request.hostport}
}

portal.example.com, *.i.example.com {
 tls /etc/caddy/auriga-tls/fullchain.pem /etc/caddy/auriga-tls/privkey.pem
 encode gzip
 reverse_proxy https://192.0.2.10:18080 {
  import auriga_backend_mtls
 }
}

admin.example.com {
 tls /etc/caddy/auriga-tls/fullchain.pem /etc/caddy/auriga-tls/privkey.pem
 encode gzip
 reverse_proxy https://192.0.2.10:18082 {
  import auriga_backend_mtls
 }
}
