logging {
  level = "info"
  format = "json"
}
discovery.docker "compose" {
  host = "unix:///var/run/docker.sock"
  filter {
    name = "label"
    values = ["com.docker.compose.project=" + sys.env("COMPOSE_PROJECT_NAME")]
  }
}
discovery.relabel "compose" {
  targets = discovery.docker.compose.targets
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label = "service"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex = "/(.*)"
    target_label = "container"
  }
  rule {
    target_label = "job"
    replacement = "auriga-nas"
  }
}
loki.source.docker "compose" {
  host = "unix:///var/run/docker.sock"
  targets = discovery.relabel.compose.output
  forward_to = [loki.write.local.receiver]
}

// Runtime instances are not Compose members. Discovery is observational only.
discovery.docker "managed" {
  host = "unix:///var/run/docker.sock"
  filter {
    name = "label"
    values = ["auriga.managed=true"]
  }
}
discovery.relabel "managed" {
  targets = discovery.docker.managed.targets
  rule {
    source_labels = ["__meta_docker_container_label_auriga_observability_edge"]
    regex = sys.env("COMPOSE_PROJECT_NAME") + "-edge"
    action = "keep"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex = "/(.*)"
    target_label = "container"
  }
  rule {
    target_label = "service"
    replacement = "dsh-instance"
  }
  rule {
    target_label = "job"
    replacement = "auriga-nas"
  }
}
loki.source.docker "managed" {
  host = "unix:///var/run/docker.sock"
  targets = discovery.relabel.managed.output
  forward_to = [loki.write.local.receiver]
}

local.file_match "plugin" {
  path_targets = [{ "__path__" = "/var/log/auriga-plugin/auriga-dsh-*.jsonl*", "service" = "dsh-plugin", "job" = "auriga-plugin" }]
}
loki.source.file "plugin" {
  targets = local.file_match.plugin.targets
  forward_to = [loki.write.local.receiver]
}
loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
