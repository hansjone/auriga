# Build from repository root: docker build -f deploy/compose/Dockerfile.platform .
FROM eclipse-temurin:25-jdk AS build
WORKDIR /src
COPY mvnw ./
COPY .mvn .mvn
RUN sh .mvn/wrapper/bootstrap.sh
COPY . .
RUN ./mvnw -q -pl services/platform-app -am -DskipTests package

FROM eclipse-temurin:25-jre
RUN apt-get update \
  && apt-get install -y --no-install-recommends curl \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /src/services/platform-app/target/platform-app-*-exec.jar /app/platform.jar
EXPOSE 8081 7443
ENTRYPOINT ["java", "-jar", "/app/platform.jar"]
