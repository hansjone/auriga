# Build from repository root: docker build -f deploy/compose/Dockerfile.edge .
FROM node:22-bookworm AS web
WORKDIR /src
COPY package.json pnpm-workspace.yaml .npmrc .prettierrc.json tsconfig.base.json ./
# Keep the workspace importers and the configured lockfileDir; never copy host
# node_modules or a previous dist into the image build.
COPY web/pnpm-lock.yaml ./web/pnpm-lock.yaml
COPY web/shared/package.json ./web/shared/package.json
COPY web/portal/package.json ./web/portal/package.json
COPY web/admin/package.json ./web/admin/package.json
COPY web/panel/package.json ./web/panel/package.json
COPY clients/dsh-plugin/package.json ./clients/dsh-plugin/package.json
RUN corepack enable \
  && corepack prepare pnpm@11.28.6 --activate \
  && pnpm install --frozen-lockfile
COPY contracts ./contracts
COPY web/shared/src ./web/shared/src
COPY web/shared/scripts ./web/shared/scripts
COPY clients/dsh-plugin/src ./clients/dsh-plugin/src
COPY clients/dsh-plugin/scripts/gen-connect-config.mjs ./clients/dsh-plugin/scripts/gen-connect-config.mjs
COPY web/portal/src ./web/portal/src
COPY web/portal/index.html web/portal/instance-login.html web/portal/vite.config.ts ./web/portal/
COPY web/portal/logout.html ./web/portal/
COPY web/admin/src ./web/admin/src
COPY web/admin/index.html web/admin/vite.config.ts ./web/admin/
COPY web/panel/src ./web/panel/src
COPY web/panel/vite.config.ts web/panel/tsconfig.json ./web/panel/
RUN pnpm gen:api \
  && pnpm gen:steps \
  && pnpm --filter @auriga/portal build \
  && pnpm --filter @auriga/admin build \
  && pnpm --filter @auriga/panel build

FROM golang:1.27.3 AS build
WORKDIR /src/infra
COPY infra/ ./
COPY third_party/bifrost/core /src/third_party/bifrost/core
WORKDIR /src/infra/edge
RUN CGO_ENABLED=0 go build -o /out/auriga-edge .
WORKDIR /src/infra/ai-gateway
RUN CGO_ENABLED=0 go build -o /out/auriga-ai-gateway . \
  && CGO_ENABLED=0 go build -o /out/auriga-network-broker github.com/nats-io/nats-server/v2
WORKDIR /src/infra/egress
RUN CGO_ENABLED=0 go build -o /out/auriga-egress .
WORKDIR /src/deploy/bootstrap
COPY deploy/bootstrap/ ./
RUN CGO_ENABLED=0 go build -o /out/auriga-network-probe ./cmd/network-probe
RUN CGO_ENABLED=0 go build -o /out/auriga-panel ./cmd/panel

# Either image may initialize these volumes; keep their writers identical.
RUN mkdir -p /out/egress-policies /out/egress-reports \
  && chmod 0755 /out/egress-policies /out/egress-reports

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build --chown=10001:10001 /out/egress-policies /var/auriga-egress/policies
COPY --from=build --chown=65532:65532 /out/egress-reports /var/auriga-egress/reports
COPY --from=build /out/auriga-edge /auriga-edge
COPY --from=build /out/auriga-ai-gateway /auriga-ai-gateway
COPY --from=build /out/auriga-egress /auriga-egress
COPY --from=build /out/auriga-network-broker /auriga-network-broker
COPY --from=build /out/auriga-network-probe /auriga-network-probe
COPY --from=build /out/auriga-panel /auriga-panel
COPY --from=web /src/web/panel/dist /srv/auriga/static/panel
COPY --from=web /src/web/portal/dist /srv/auriga/static/portal
COPY --from=web /src/web/admin/dist /srv/auriga/static/admin
ENV AURIGA_EDGE_STATIC_PORTAL=/srv/auriga/static/portal \
    AURIGA_EDGE_STATIC_ADMIN=/srv/auriga/static/admin
ENTRYPOINT ["/auriga-edge"]
