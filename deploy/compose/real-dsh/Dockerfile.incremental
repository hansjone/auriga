# Optional plugin-only update from an operator-verified signed real-dsh image.
# Build with scripts/build-real-dsh-incremental.mjs and its checked private context.
# BASE_RUNTIME_IMAGE must be a complete repository@sha256 digest, never a tag.
ARG BASE_RUNTIME_IMAGE
FROM ${BASE_RUNTIME_IMAGE}
ARG BASE_RUNTIME_IMAGE
USER 0:0
# Require the fixed offline runtime tool before touching the old source.
RUN if ! node /opt/fixture/tooling.mjs installed; then \
      echo "Incremental base lacks fixed runtime pnpm; rebuild the full real-dsh image." >&2; exit 1; \
    fi
COPY real-dsh-inputs/deploy/compose/real-dsh/ /tmp/auriga-incremental/recipe/
COPY real-dsh-inputs/clients/dsh-plugin/package*.json /tmp/auriga-incremental/plugin/
COPY real-dsh-inputs/clients/installer/upstream.json /tmp/auriga-incremental/runtime-pins.json
# Refuse changed foundations and verify the managed broker before deleting src.
RUN node /tmp/auriga-incremental/recipe/incremental.mjs
COPY real-dsh-inputs/clients/dsh-plugin/src /opt/auriga-dsh/src
COPY real-dsh-inputs/clients/dsh-plugin/LICENSE /opt/auriga-dsh/LICENSE
COPY real-dsh-inputs/clients/dsh-plugin/cordis.patch.yml /opt/auriga-dsh/cordis.patch.yml
# Normalize only the new public plugin inputs. Keep proof generation on the base toolchain.
RUN node /tmp/auriga-incremental/recipe/source-modes.mjs /opt/auriga-dsh/src \
      /opt/auriga-dsh/LICENSE /opt/auriga-dsh/cordis.patch.yml \
    && node --import /tmp/auriga-incremental/recipe/incremental-fs.mjs /opt/fixture/build.mjs manifest \
    && rm -rf /tmp/auriga-incremental
ENV HOME=/home/dsh DSH_TELEMETRY_DISABLED=1 DSH_TELEMETRY_MODE=DISABLED
WORKDIR /home/dsh
USER 200000:200000
RUN --network=none node /opt/fixture/runtime.mjs
EXPOSE 7860
ENTRYPOINT ["node", "/opt/fixture/start.mjs"]
